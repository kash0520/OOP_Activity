@startuml
skinparam classAttributeIconSize 0
class Product {
  - id : Long
  - name : String
  - price : double
  + getId() : Long
  + getName() : String
  + getPrice() : double
}
class DigitalProduct {
  - downloadUrl : String
  - fileSizeMB : double
  + getDownloadUrl() : String
  + getFileSizeMB() : double
}
class PhysicalProduct {
  - weightKg : double
  - dimensions : String
  + getWeightKg() : double
  + getDimensions() : String
}
Product <|-- DigitalProduct
Product <|-- PhysicalProduct
@enduml
